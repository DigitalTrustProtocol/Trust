# .env.example – copy to `.env` for local development (loaded automatically by the CLI)

# PostgreSQL connection string (replace with real values)
DATABASE_URL=postgres://postgres:your-strong-password@your-db-resource-name:5432/your-database-name?sslmode=disable

# Or split (some libraries prefer this)
PGHOST=your-db-resource-name
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-strong-password
PGDATABASE=your-database-name

# Optional: force backend or URL (otherwise: use Postgres if DATABASE_URL or PGHOST+… is set, else SQLite)
# TRUST_DB_DRIVER=postgres
# TRUST_POSTGRES_URL=postgres://...
# PGSSLMODE=disable