{
  "name": "@dtp/trust",
  "version": "0.1.0",
  "description": "Decentralized Web of Trust identity and reputation for AI agents — CLI, SDK, HTTP server, and MCP tools",
  "type": "module",
  "main": "dist/sdk.js",
  "bin": {
    "trust": "dist/index.js",
    "trust-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": "./dist/sdk.js",
    "./cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsc && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed-trust-network.ts",
    "seed-deg45": "tsx scripts/seed-trust-network-deg45.ts",
    "heavy": "tsx scripts/heavy-load-test.ts",
    "verify": "tsx scripts/verify-trust-graph.ts",
    "load-test-keys": "tsx scripts/load-test-keys.ts",
    "test-sab-large": "tsx scripts/test-large-shared-array-buffer.ts"
  },
  "keywords": [
    "nostr",
    "web-of-trust",
    "reputation",
    "ai-agents",
    "decentralized",
    "cli"
  ],
  "author": "keutmann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalTrustProtocol/Trust.git"
  },
  "homepage": "https://trust.dance",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^1.7.1",
    "@nostrify/db": "^0.39.25",
    "@nostrify/nostrify": "^0.49.2",
    "@thi.ng/malloc": "^6.1.142",
    "@types/pg": "^8.18.0",
    "better-sqlite3": "^12.6.2",
    "commander": "^13.1.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "msgpackr": "^1.11.0",
    "nostr-tools": "^2.10.4",
    "pg": "^8.20.0",
    "pg-cursor": "^2.19.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pretty-bytes": "^7.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sqlite": "^5.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
